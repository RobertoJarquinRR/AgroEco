<Window x:Class="AgroEco.UI.login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AgroEco.UI"
        mc:Ignorable="d"
        Title="login"
Width="1200"
        Height="650"
        WindowStartupLocation="CenterScreen"
    Background="#EEEEEE">

    <Window.Resources>
        
        <SolidColorBrush x:Key="VerdeOscuro" Color="#1F6F5F"/>
            <SolidColorBrush x:Key="Verde" Color="#2FA084"/>
            <SolidColorBrush x:Key="VerdeClaro" Color="#6FCF97"/>
            <SolidColorBrush x:Key="Naranja" Color="#FAA533"/>

            <Style x:Key="InputStyle" TargetType="TextBox">
                <Setter Property="Height" Value="58"/>
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="Padding" Value="18,0"/>
                <Setter Property="BorderBrush" Value="#CCCCCC"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Background" Value="#FAFAFA"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>

        </Window.Resources>

    <Border Margin="5"
            CornerRadius="35"
            Background="White">

        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50*"/>
                <ColumnDefinition Width="50*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#27806D"
                    CornerRadius="35,0,0,35"
                    ClipToBounds="True">
            </Border>

            <Grid Grid.Column="1"
                  Margin="55,35,55,25">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="iniciar sesión"
                           FontSize="40"
                           FontWeight="Bold"
                           Foreground="#222222"/>

                <TextBlock Grid.Row="1"
                           Text="Ingresa tus credenciales"
                           FontSize="24"
                           Foreground="#71828A"
                           Margin="0,10,0,55"/>

                <StackPanel Grid.Row="2">

                    <TextBlock Text="Usuario*"
                               FontSize="23"
                               FontWeight="SemiBold"
                               Foreground="#222222"
                               Margin="0,0,0,10"/>

                    <Border Height="58"
                            CornerRadius="15"
                            BorderBrush="#CCCCCC"
                            BorderThickness="1"
                            Background="#FAFAFA">

                        <Grid>

                            <TextBox x:Name="txtUsuario"
                                     Style="{StaticResource InputStyle}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Padding="18,0,60,0" FocusableChanged="txtUsuario_FocusableChanged"/>

                            <TextBlock Text="✉"
                                       FontSize="28"
                                       Foreground="#C9CECE"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Margin="0,0,18,0"/>

                        </Grid>

                    </Border>

                </StackPanel>

                <StackPanel Grid.Row="3"
                            Margin="0,30,0,0">

                    <Grid Margin="0,0,0,10">

                        <TextBlock Text="Password*"
                                   FontSize="23"
                                   FontWeight="SemiBold"
                                   Foreground="#222222"/>

                    </Grid>


                    <Border Height="58"
                            CornerRadius="15"
                            BorderBrush="#CCCCCC"
                            BorderThickness="1"
                            Background="#FAFAFA">

                        <Grid>

                            <PasswordBox x:Name="txtPassword"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         FontSize="22"
                                         Padding="18,0,60,0"
                                         VerticalContentAlignment="Center"/>

                            <TextBlock Text="◉"
                                       FontSize="25"
                                       Foreground="#C9CECE"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Margin="0,0,18,0"/>

                        </Grid>

                    </Border>

                </StackPanel>

                <Button Grid.Row="4"
                        x:Name="btnEntrar"
                        Height="65"
                        Margin="0,55,0,0"
                        Background="#2FA084"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="26"
                        FontWeight="Bold"
                        Cursor="Hand" Click="btnEntrar_Click_1">

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="Entrar"/>

                        <TextBlock Text="→"
                                   FontSize="30"
                                   Margin="25,0,0,0"/>

                    </StackPanel>

                </Button>

                <StackPanel Grid.Row="5"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,45,0,0"/>

            </Grid>

        </Grid>

    </Border>
</Window>
